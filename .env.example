# One Piece Timeline - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port the backend server will run on
PORT=8080

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB connection URI
# For local development with Docker: mongodb://localhost:27017
# For production: Use your MongoDB Atlas or hosted instance URI
MONGODB_URI=mongodb://localhost:27017

# Database name
# This is configured in application.yaml, but can be overridden here if needed
# MONGODB_DATABASE=one_piece_timeline

# ============================================================================
# DEVELOPMENT API KEYS
# ============================================================================
# WARNING: These keys are for DEVELOPMENT ONLY!
# NEVER use these in production!
#
# Use these API keys to test the application locally:
#
# Admin (full access - create/edit/delete/revert):
#   X-API-Key: dev-admin-key-CHANGE-IN-PRODUCTION
#
# Editor (create and edit only):
#   X-API-Key: dev-editor-key-CHANGE-IN-PRODUCTION
#
# Viewer (read-only access):
#   X-API-Key: dev-viewer-key-CHANGE-IN-PRODUCTION
#
# These keys are automatically created when you start the database
# with Docker Compose (see scripts/mongo-init.js)

# ============================================================================
# PRODUCTION NOTES
# ============================================================================
# When deploying to production:
# 1. Generate secure random API keys for your users
# 2. Never commit actual API keys to version control
# 3. Use environment variables or secrets management
# 4. Update MONGODB_URI to your production database
# 5. Configure appropriate PORT for your hosting environment
