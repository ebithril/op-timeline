# One Piece Timeline Frontend - Environment Configuration
# Copy this file to .env for local development

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Base URL for the backend API
# Leave empty for local development (Vite proxy is configured in vite.config.js)
# For production builds, set to your deployed backend URL
VITE_API_BASE_URL=

# Examples:
# Local development (proxy): VITE_API_BASE_URL=
# Production: VITE_API_BASE_URL=https://your-api-domain.com
# Custom backend: VITE_API_BASE_URL=http://localhost:8080
